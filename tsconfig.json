      "@deepseek-ai/dsh-tool-todo/types": ["../deepseek-harness/packages/todo/tool-todo/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-tool-todo/client": ["../deepseek-harness/packages/todo/tool-todo/lib/types/client.d.ts"],
      "@deepseek-ai/dsh-workflow/types": ["../deepseek-harness/packages/workflow/workflow/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-tool-workflow/types": ["../deepseek-harness/packages/workflow/tool-workflow/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-credentials/types": ["../deepseek-harness/packages/credentials/credentials/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-jobs/brand": ["../deepseek-harness/packages/jobs/jobs/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-*": [
        "../deepseek-harness/packages/core/*/lib/types", "../deepseek-harness/packages/core/*/src",
