{
  // Type contract source: host packages' built lib/types artifacts (exact
  // rc.5 baseline, including generated /remote contracts) with src fallback
  // for packages without build output. The host base's src-only paths cannot
  // compile here (generated Typert contracts live in lib), so this project
  // overrides the full paths table while inheriting its compiler options.
  "extends": "../../../deepseek-harness/tsconfig.base.client.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      // The fork's own package specifier: node-half types and the browser
      // module augmentation target (declare module 'dsh-chat-focus/client').
      "dsh-chat-focus": ["./src"],
      "dsh-chat-focus/client": ["./src/client"],
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/lib/types"],
      "@deepseek-ai/cordis/*": ["../deepseek-harness/vendor/cordis/lib/types/*"],
      "@deepseek-ai/cosmokit": ["../deepseek-harness/vendor/cosmokit/lib/types"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/lib/types"],
      // Order matters: TS matches the FIRST declared pattern, so the
      // subpath patterns (/client, /invariant) must precede the bare
      // package pattern.
      "@deepseek-ai/dsh-client-*/client": [
        "../deepseek-harness/packages/client/*/lib/types/client",
        "../deepseek-harness/packages/client/*/src/client"
      ],
      "@deepseek-ai/dsh-client-*/invariant": [
        "../deepseek-harness/packages/client/*/lib/types/invariant.d.ts",
        "../deepseek-harness/packages/client/*/src/invariant.ts"
      ],
      "@deepseek-ai/dsh-client-*": [
        "../deepseek-harness/packages/client/*/lib/types",
        "../deepseek-harness/packages/client/*/src"
      ],
      "@deepseek-ai/dsh-host-apiproxy": [
        "../deepseek-harness/packages/host/apiproxy/lib/types",
        "../deepseek-harness/packages/host/apiproxy/src"
      ],
      "@deepseek-ai/dsh-host-apiproxy/*": [
        "../deepseek-harness/packages/host/apiproxy/lib/types/*",
        "../deepseek-harness/packages/host/apiproxy/src/*"
      ],
      "@deepseek-ai/dsh-api-remotes": [
        "../deepseek-harness/packages/api/remotes/lib/types",
        "../deepseek-harness/packages/api/remotes/src"
      ],
      "@deepseek-ai/dsh-api-remotes/client": [
        "../deepseek-harness/packages/api/remotes/lib/types/client",
        "../deepseek-harness/packages/api/remotes/src/client"
      ],
      "@deepseek-ai/dsh-api-remotes/types": [
        "../deepseek-harness/packages/api/remotes/lib/types/types.d.ts",
        "../deepseek-harness/packages/api/remotes/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-api-remotes/invariant": [
        "../deepseek-harness/packages/api/remotes/lib/types/invariant.d.ts",
        "../deepseek-harness/packages/api/remotes/lib/types/invariant.d.ts"
      ],
      "@deepseek-ai/dsh-api-gateway": [
        "../deepseek-harness/packages/api/gateway/lib/types",
        "../deepseek-harness/packages/api/gateway/src"
      ],
      "@deepseek-ai/dsh-api-gateway/*": [
        "../deepseek-harness/packages/api/gateway/lib/types/*",
        "../deepseek-harness/packages/api/gateway/src/*"
      ],
      // Non-client leaf modules (types/brand/checkpoint surfaces): no lib
      // build output, so resolve straight to host src files.
      "@deepseek-ai/dsh-invariants": ["../deepseek-harness/packages/runtime-diagnostics/invariants/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm/types": ["../deepseek-harness/packages/llm/llm/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-llm/brand": ["../deepseek-harness/packages/llm/llm/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-llm-retry/types": ["../deepseek-harness/packages/llm/llm-retry/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-commands/types": ["../deepseek-harness/packages/interaction/commands/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-commands/brand": ["../deepseek-harness/packages/interaction/commands/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-session/types": ["../deepseek-harness/packages/core/session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-session-stats/types": ["../deepseek-harness/packages/session/session-stats/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-session-stats/client": ["../deepseek-harness/packages/session/session-stats/lib/types/client.d.ts"],
      "@deepseek-ai/dsh-token-meter/client": ["../deepseek-harness/packages/llm/token-meter/lib/types/client.d.ts"],
      "@deepseek-ai/dsh-compaction/checkpoint": ["../deepseek-harness/packages/compaction/compaction/lib/types/checkpoint.d.ts"],
      "@deepseek-ai/dsh-compaction/types": ["../deepseek-harness/packages/compaction/compaction/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-tools/types": ["../deepseek-harness/packages/core/tools/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-tools/presentation": ["../deepseek-harness/packages/core/tools/lib/types/presentation.d.ts"],
      "@deepseek-ai/dsh-settings/types": ["../deepseek-harness/packages/settings/settings/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-agent/types": ["../deepseek-harness/packages/core/agent/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-agent/brand": ["../deepseek-harness/packages/core/agent/lib/types/brand.d.ts"],
